{
  "name": "vnd-tech-billing-desktop",
  "productName": "VND Tech Billing Software",
  "version": "1.0.0",
  "description": "Native Electron Desktop Shell for VND Tech Billing Software",
  "author": "VND Tech <contact@vndtech.in>",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "copy:frontend": "node -e \"const fs = require('fs'); fs.cpSync('../frontend/dist', './frontend/dist', { recursive: true });\"",
    "build": "vite build && npm run copy:frontend",
    "dev": "vite build && electron dist/main.js",
    "start": "electron dist/main.js",
    "build:win": "npm run build && electron-builder --win --x64",
    "pack:dir": "npm run build && electron-builder --dir",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
